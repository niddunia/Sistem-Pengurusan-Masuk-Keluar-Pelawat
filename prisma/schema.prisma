// PRD - Sistem Pengurusan Masuk-Keluar Pelawat | PLTT Bintulu, JTM
// Visitor Entry & Exit Management System (VMS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== PROFILES - System Users (Security / Staff / Admin) =====
model Profile {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  fullName     String
  role         String    @default("staff") // security | staff | admin
  departmentId String?
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department          Department?          @relation(fields: [departmentId], references: [id])
  hostedVisits        Visit[]              @relation("HostStaffVisits")
  approvedVisits      Visit[]              @relation("ApprovedByVisits")
  registeredVisits    Visit[]              @relation("RegisteredByVisits")
  exitConfirmedVisits Visit[]              @relation("ExitConfirmedByVisits")
  auditLogs           AuditLog[]
  blacklistEntries    Blacklist[]
  notifications       Notification[]

  @@index([role])
  @@index([departmentId])
}

// ===== DEPARTMENTS =====
model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  profiles Profile[]
}

// ===== VISITORS =====
model Visitor {
  id           String    @id @default(cuid())
  fullName     String
  icPassportNo String
  phone        String
  email        String?
  company      String?
  photoUrl     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  visits    Visit[]
  documents VisitorDocument[]

  @@index([icPassportNo])
  @@index([phone])
}

// ===== VISITS - Core table =====
model Visit {
  id                  String    @id @default(cuid())
  referenceCode       String    @unique
  visitorId           String
  purpose             String
  hostStaffId         String
  registeredById      String? // security guard (walk-in) or null (self-service)
  expectedVisitDate   DateTime
  status              String    @default("pending_approval")
  // pending_approval | approved | rejected | checked_in | in_progress |
  // staff_verified | pending_feedback | feedback_submitted | ready_for_exit |
  // checked_out | cancelled

  approvedById        String?
  approvedAt          DateTime?
  rejectionReason     String?
  checkedInAt         DateTime?
  staffVerifiedAt     DateTime?
  staffRemarks        String?
  feedbackSubmittedAt DateTime?
  exitConfirmedById   String?
  exitNotes           String?
  checkedOutAt        DateTime?
  pdpaConsent         Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  visitor        Visitor       @relation(fields: [visitorId], references: [id])
  hostStaff      Profile       @relation("HostStaffVisits", fields: [hostStaffId], references: [id])
  registeredBy   Profile?      @relation("RegisteredByVisits", fields: [registeredById], references: [id])
  approvedBy     Profile?      @relation("ApprovedByVisits", fields: [approvedById], references: [id])
  exitConfirmedBy Profile?     @relation("ExitConfirmedByVisits", fields: [exitConfirmedById], references: [id])
  documents      VisitorDocument[]
  feedback       Feedback?
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@index([status])
  @@index([hostStaffId])
  @@index([visitorId])
  @@index([referenceCode])
}

// ===== VISITOR DOCUMENTS - ID proof files =====
model VisitorDocument {
  id         String   @id @default(cuid())
  visitorId  String
  visitId    String
  docType    String   // mykad | passport | other
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())

  visitor Visitor @relation(fields: [visitorId], references: [id])
  visit   Visit   @relation(fields: [visitId], references: [id])

  @@index([visitorId])
  @@index([visitId])
}

// ===== FEEDBACK =====
model Feedback {
  id           String   @id @default(cuid())
  visitId      String   @unique
  rating       Int      // 1-5
  comments     String?
  submittedAt  DateTime @default(now())

  visit Visit @relation(fields: [visitId], references: [id])
}

// ===== AUDIT LOGS - Immutable action trail =====
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  // null = system/anon
  actorRole  String   // visitor | security | staff | admin | system
  action     String   // visit_create | visit_approve | visit_reject | visit_checkin | visit_verify | visit_feedback | visit_exit | user_create | user_update | user_deactivate | department_create | login | login_failed | settings_update
  visitId    String?
  details    String   // JSON string of additional data
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor Profile? @relation(fields: [actorId], references: [id])
  visit Visit?   @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ===== NOTIFICATIONS =====
model Notification {
  id             String   @id @default(cuid())
  recipientId    String?
  recipientType  String   // staff | security | admin | visitor
  visitId        String?
  channel        String   @default("in_app") // in_app | email | sms
  title          String
  message        String
  isRead         Boolean  @default(false)
  sentAt         DateTime @default(now())

  recipient Profile? @relation(fields: [recipientId], references: [id])
  visit     Visit?   @relation(fields: [visitId], references: [id])

  @@index([recipientId])
  @@index([isRead])
}

// ===== BLACKLIST (Phase 2 - included for completeness) =====
model Blacklist {
  id            String   @id @default(cuid())
  icPassportNo  String   @unique
  reason        String
  addedById     String
  addedAt       DateTime @default(now())

  addedBy Profile @relation(fields: [addedById], references: [id])
}

// ===== SYSTEM SETTINGS =====
model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON string
}
